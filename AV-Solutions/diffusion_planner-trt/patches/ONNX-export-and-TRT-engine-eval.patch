+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+#!/bin/bash
+
+set -e
+
+show_help() {
+    echo "Usage: $0 --onnx <input.onnx> --engine <output.engine> [--fp16]"
+    echo ""
+    echo "Options:"
+    echo "  --onnx     Path to input ONNX model"
+    echo "  --engine   Path to output TensorRT engine"
+    echo "  --fp16     Enable mixed-precision mode (assumes ONNX is already FP16)"
+    exit 1
+}
+
+# Default
+USE_FP16=false
+
+# Parse args
+while [[ $# -gt 0 ]]; do
+    case $1 in
+        --onnx)
+            ONNX_PATH="$2"
+            shift 2
+            ;;
+        --engine)
+            ENGINE_PATH="$2"
+            shift 2
+            ;;
+        --fp16)
+            USE_FP16=true
+            shift
+            ;;
+        -*|--*)
+            echo "Unknown option $1"
+            show_help
+            ;;
+        *)
+            break
+            ;;
+    esac
+done
+
+# Validate required arguments
+if [[ -z "$ONNX_PATH" || -z "$ENGINE_PATH" ]]; then
+    echo "Error: --onnx and --engine are required."
+    show_help
+fi
+
+# Build
+COMMON_FLAGS="--onnx=$ONNX_PATH \
+              --saveEngine=$ENGINE_PATH \
+              --noTF32 \
+              --builderOptimizationLevel=5 \
+              --tilingOptimizationLevel=3 \
+              --maxTactics=2000"
+
+if $USE_FP16; then
+    echo "🔧 Building FP16 engine with strongly typed model..."
+    trtexec $COMMON_FLAGS --stronglyTyped
+    echo "✅ FP16 TensorRT engine built: $ENGINE_PATH"
+else
+    echo "🔧 Building FP32 engine..."
+    trtexec $COMMON_FLAGS
+    echo "✅ FP32 TensorRT engine built: $ENGINE_PATH"
+fi

+import warnings
+import numpy as np
+import socket
+import struct
+from typing import Deque, Dict, List, Type
+
+warnings.filterwarnings("ignore")
+
+from nuplan.common.actor_state.ego_state import EgoState
+from nuplan.common.utils.interpolatable_state import InterpolatableState
+from nuplan.planning.simulation.trajectory.trajectory_sampling import TrajectorySampling
+from nuplan.planning.simulation.trajectory.abstract_trajectory import AbstractTrajectory
+from nuplan.planning.simulation.trajectory.interpolated_trajectory import InterpolatedTrajectory
+from nuplan.planning.simulation.observation.observation_type import Observation, DetectionsTracks
+from nuplan.planning.simulation.planner.ml_planner.transform_utils import transform_predictions_to_states
+from nuplan.planning.simulation.planner.abstract_planner import AbstractPlanner, PlannerInitialization, PlannerInput
+
+from diffusion_planner.data_process.data_processor import DataProcessor
+from diffusion_planner.utils.config import Config
+
+# Global persistent socket per Ray worker
+_GLOBAL_SOCKET = None
+
+
+# ====================================================
+# Socket Management (Persistent Across Scenarios)
+# ====================================================
+
+def get_socket(app_ip, app_port, socket_timeout):
+    """
+    Establish or retrieve a persistent socket connection to TensorRT app.
+    Reconnects only if the socket is stale or timed out.
+    """
+    global _GLOBAL_SOCKET
+
+    if _GLOBAL_SOCKET is not None:
+        try:
+            # Test socket without sending data that could interfere with protocol
+            _GLOBAL_SOCKET.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR)
+            return _GLOBAL_SOCKET
+        except (BrokenPipeError, ConnectionResetError, TimeoutError, OSError):
+            # print("[TRT App] Stale connection detected. Reconnecting...")
+            close_socket()
+
+    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    # Increase timeout for large data transfers
+    client.settimeout(max(socket_timeout, 120))  # At least 2 minutes
+    
+    # Set socket buffer sizes for large data transfers  
+    client.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 16 * 1024 * 1024)  # 16MB send buffer
+    client.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 16 * 1024 * 1024)  # 16MB recv buffer
+    
+    client.connect((app_ip, app_port))
+    # print(f"[TRT App] Connected to TRT App at {app_ip}:{app_port}")
+    _GLOBAL_SOCKET = client
+    return _GLOBAL_SOCKET
+
+
+def close_socket():
+    """
+    Cleanly closes the TensorRT app socket connection.
+    Called only when tearing down Ray workers (not after every scenario).
+    """
+    global _GLOBAL_SOCKET
+    if _GLOBAL_SOCKET:
+        try:
+            _GLOBAL_SOCKET.shutdown(socket.SHUT_RDWR)
+        except OSError:
+            pass
+        try:
+            _GLOBAL_SOCKET.close()
+        except OSError:
+            pass
+        # print("[TRT App] Socket closed.")
+        _GLOBAL_SOCKET = None
+
+
+# ====================================================
+# Diffusion Planner (NuPlan + TensorRT App)
+# ====================================================
+class DiffusionPlanner_TRT(AbstractPlanner):
+    """
+    NuPlan Planner using TensorRT engine over socket (replaces ONNXRuntime).
+    One persistent socket per Ray worker for all scenarios.
+    """
+
+    def __init__(
+        self,
+        config: Config,
+        ckpt_path: str,
+
+        past_trajectory_sampling: TrajectorySampling,
+        future_trajectory_sampling: TrajectorySampling,
+
+        app_ip: str,
+        app_port: int = 5555,
+        socket_timeout: int = 10,
+
+        # FP16 support
+        engine_dtype: str = "fp32",  # "fp32" or "fp16"
+        
+        device: str = "cpu",
+    ):
+        self._config = config
+        self._ckpt_path = ckpt_path
+
+        self._future_horizon = future_trajectory_sampling.time_horizon
+        self._step_interval = future_trajectory_sampling.time_horizon / future_trajectory_sampling.num_poses
+
+        self._past_trajectory_sampling = past_trajectory_sampling
+        self._future_trajectory_sampling = future_trajectory_sampling
+
+        self.app_ip = app_ip
+        self.app_port = app_port
+        self.socket_timeout = socket_timeout
+
+        # FP16 support
+        self.engine_dtype = engine_dtype.lower()
+        if self.engine_dtype not in ["fp32", "fp16"]:
+            raise ValueError(f"engine_dtype must be 'fp32' or 'fp16', got '{engine_dtype}'")
+
+        self.data_processor = DataProcessor(config)
+        self.observation_normalizer = config.observation_normalizer
+
+        self._map_api = None
+        self._route_roadblock_ids = None
+        self._initialization = None
+        self._data_count = 0
+
+        # TensorRT engine input order — must match TRT binding order!
+        self.trt_input_order = [
+            "ego_current_state",
+            "neighbor_agents_past",
+            "static_objects",
+            "lanes",
+            "lanes_speed_limit",
+            "lanes_has_speed_limit",
+            "route_lanes",
+        ]
+        self.trt_output_name = "decoder_outputs"
+
+    def name(self) -> str:
+        return "diffusion_planner_trt"
+
+    def observation_type(self) -> Type[Observation]:
+        return DetectionsTracks
+
+    def initialize(self, initialization: PlannerInitialization) -> None:
+        """
+        Called by NuPlan inside Ray worker (runs once per worker, not per scenario).
+        """
+        self._map_api = initialization.map_api
+        self._route_roadblock_ids = initialization.route_roadblock_ids
+        self._initialization = initialization
+        get_socket(self.app_ip, self.app_port, self.socket_timeout)  # ✅ Persistent connection established early
+
+    def planner_input_to_model_inputs(self, planner_input: PlannerInput) -> Dict[str, np.ndarray]:
+        """
+        Converts NuPlan inputs into normalized numpy arrays for TRT.
+        """
+        history = planner_input.history
+        traffic_light_data = list(planner_input.traffic_light_data)
+
+        model_inputs = self.data_processor.observation_adapter(
+            history, traffic_light_data, self._map_api, self._route_roadblock_ids, device="cpu"
+        )
+        model_inputs = self.observation_normalizer(model_inputs)
+        
+        # Convert to appropriate dtype based on engine_dtype
+        target_dtype = np.float16 if self.engine_dtype == "fp16" else np.float32
+        inputs_np = {k: v.cpu().numpy().astype(target_dtype) for k, v in model_inputs.items()}
+
+        for name, arr in inputs_np.items():
+            expected_dtype = np.float16 if self.engine_dtype == "fp16" else np.float32
+            assert arr.dtype == expected_dtype, f"Input {name} is not {expected_dtype}! Got {arr.dtype}"
+
+        # Patch missing neighbor agents (if any)
+        if "neighbor_agents_past" in inputs_np and inputs_np["neighbor_agents_past"].shape[1] == 0:
+            orig_shape = inputs_np["neighbor_agents_past"].shape
+            inputs_np["neighbor_agents_past"] = np.zeros(
+                (orig_shape[0], 1, orig_shape[2], orig_shape[3]), dtype=target_dtype
+            )
+            print(f"[Patch] Injected dummy neighbor agent")
+
+        return inputs_np
+
+    def _run_trt_inference(self, inputs_np: Dict[str, np.ndarray]) -> np.ndarray:
+        try:
+            client = get_socket(self.app_ip, self.app_port, self.socket_timeout)
+            tensors = [inputs_np[name] for name in self.trt_input_order]
+
+            # Convert tensors to appropriate dtype for transmission
+            target_dtype = np.float16 if self.engine_dtype == "fp16" else np.float32
+            tensors = [t.astype(target_dtype, copy=False) for t in tensors]
+
+            # 1) Build header (explicit little-endian)
+            header = [len(tensors)]
+            data_bytes = []
+            for t in tensors:
+                header.append(len(t.shape))
+                header.extend(list(map(int, t.shape)))
+                data_bytes.append(t.tobytes())
+            header_bytes = struct.pack("<" + "i" * len(header), *header)
+
+            payload = header_bytes + b"".join(data_bytes)
+            msg_size = len(payload)
+
+            # 2) Send size (little-endian 4 bytes), then payload
+            client.sendall(struct.pack("<i", msg_size))
+            client.sendall(payload)
+
+            # 3) Receive output size
+            sz_bytes = client.recv(4)
+            if len(sz_bytes) < 4:
+                raise ConnectionError("[TRT App] Failed to read output size.")
+            (out_size,) = struct.unpack("<i", sz_bytes)
+
+            # FAIL-FAST: app returns 0 when binding/order check fails
+            if out_size == 0:
+                raise ConnectionError("[TRT App] App returned 0, invalid request.")
+
+            # 4) Receive output payload
+            out_buffer = bytearray()
+            while len(out_buffer) < out_size:
+                packet = client.recv(out_size - len(out_buffer))
+                if not packet:
+                    raise ConnectionError("[TRT App] Lost connection during recv.")
+                out_buffer += packet
+
+            return np.frombuffer(out_buffer, dtype=np.float32)
+
+        except (TimeoutError, ConnectionError, OSError) as e:
+            print("[TRT App] Timeout or connection lost. Reconnecting...")
+            close_socket()
+            client = get_socket(self.app_ip, self.app_port, self.socket_timeout)
+            return self._run_trt_inference(inputs_np)
+
+    def outputs_to_trajectory(
+        self, decoder_outputs: np.ndarray, ego_state_history: Deque[EgoState]
+    ) -> List[InterpolatableState]:
+        """
+        Converts raw TRT outputs into NuPlan trajectory.
+        """
+        predictions = decoder_outputs.reshape(1, 11, 80, 4)[0, 0].astype(np.float64)
+        heading = np.arctan2(predictions[:, 3], predictions[:, 2])[..., None]
+        predictions = np.concatenate([predictions[..., :2], heading], axis=-1)
+        return transform_predictions_to_states(
+            predictions, ego_state_history, self._future_horizon, self._step_interval
+        )
+
+    def compute_planner_trajectory(self, current_input: PlannerInput) -> AbstractTrajectory:
+        """
+        Executes TensorRT inference and returns trajectory.
+        """
+        inputs_np = self.planner_input_to_model_inputs(current_input)
+        decoder_outputs = self._run_trt_inference(inputs_np)
+        trajectory = InterpolatedTrajectory(
+            trajectory=self.outputs_to_trajectory(decoder_outputs, current_input.history.ego_states)
+        )
+        return trajectory
+
+    def __getstate__(self):
+        state = self.__dict__.copy()
+        return state
+
+    def __setstate__(self, state):
+        self.__dict__.update(state)
+        get_socket(self.app_ip, self.app_port, self.socket_timeout)  # Reconnect on Ray worker deserialization
+
+    def __del__(self):
+        """
+        Clean up only when Ray worker exits.
+        """
+        close_socket()
+

+# limitations under the License.
+
+import torch.nn as nn
+from model.module.encoder_trt import Encoder_TRT
+from model.module.decoder_trt import Decoder_TRT
+
+class Diffusion_Planner_TRT(nn.Module):
+    def __init__(self, config):
+        super().__init__()
+        self.encoder = Encoder_TRT(config)
+        self.decoder = Decoder_TRT(config)
+
+    @property
+    def sde(self):
+        return self.decoder.decoder.sde
+
+    def forward(self, inputs):
+        ego_current_state, neighbor_agents_past, static_objects, lanes, \
+            lanes_speed_limit, lanes_has_speed_limit, route_lanes = inputs
+
+        dict_inputs = {
+            'ego_current_state': ego_current_state,
+            'neighbor_agents_past': neighbor_agents_past,
+            'static_objects': static_objects,
+            'lanes': lanes,
+            'lanes_speed_limit': lanes_speed_limit,
+            'lanes_has_speed_limit': lanes_has_speed_limit,
+            'route_lanes': route_lanes
+        }
+
+        encoder_outputs = self.encoder(dict_inputs)
+        decoder_outputs = self.decoder(encoder_outputs, dict_inputs)
+        return encoder_outputs, decoder_outputs

+import argparse
+import os, json
+import torch
+import torch.nn as nn
+from collections import OrderedDict
+
+import onnx
+from onnxsim import simplify
+
+from model.diffusion_planner_trt import Diffusion_Planner_TRT
+from diffusion_planner.utils.normalizer import ObservationNormalizer, StateNormalizer
+
+def get_args():
+    parser = argparse.ArgumentParser(description='Diffusion Planner ONNX Export')
+
+    parser.add_argument('--args_json', type=str, default='checkpoints/args.json',
+                        help='Path to args JSON file')
+    parser.add_argument('--model_ckpt', type=str, default='checkpoints/model.pth',
+                        help='Path to model checkpoint')
+    parser.add_argument('--onnx_output', type=str, default='diffusion_planner.onnx',
+                        help='Path to save the exported ONNX model')
+
+    # Model architecture
+    parser.add_argument('--hidden_dim', type=int, default=192)
+    parser.add_argument('--num_heads', type=int, default=6)
+    parser.add_argument('--encoder_depth', type=int, default=3)
+    parser.add_argument('--decoder_depth', type=int, default=3)
+    parser.add_argument('--encoder_drop_path_rate', type=float, default=0.1)
+    parser.add_argument('--decoder_drop_path_rate', type=float, default=0.1)
+    parser.add_argument('--diffusion_model_type', type=str, choices=['score', 'x_start'], default='x_start')
+    parser.add_argument('--device', type=str, default='cuda')
+
+    # Scenario structure
+    parser.add_argument('--agent_num', type=int, default=32)
+    parser.add_argument('--predicted_neighbor_num', type=int, default=10)
+    parser.add_argument('--time_len', type=int, default=21)
+    parser.add_argument('--future_len', type=int, default=80)
+    parser.add_argument('--static_objects_state_dim', type=int, default=10)
+    parser.add_argument('--static_objects_num', type=int, default=5)
+    parser.add_argument('--lane_len', type=int, default=20)
+    parser.add_argument('--lane_num', type=int, default=70)
+    parser.add_argument('--route_len', type=int, default=20)
+    parser.add_argument('--route_num', type=int, default=25)
+
+    # Normalization
+    parser.add_argument('--normalization_file_path', type=str, default='normalization.json')
+
+    args = parser.parse_args()
+
+    # Override with JSON config if available
+    if os.path.exists(args.args_json):
+        with open(args.args_json, 'r') as f:
+            json_args = json.load(f)
+        for k, v in json_args.items():
+            if k in ['state_normalizer', 'observation_normalizer']:
+                continue
+            setattr(args, k, v)
+
+    args.guidance_fn = None
+    args.state_normalizer = StateNormalizer.from_json(args)
+    args.observation_normalizer = ObservationNormalizer.from_json(args)
+
+    return args
+
+
+def load_ckpt_weights(model, ckpt_path, device='cuda'):
+    checkpoint = torch.load(ckpt_path, map_location=device)
+
+    if 'model' in checkpoint:
+        state_dict = checkpoint['model']
+    elif 'state_dict' in checkpoint:
+        state_dict = checkpoint['state_dict']
+    else:
+        state_dict = checkpoint
+
+    clean_state_dict = OrderedDict()
+    for k, v in state_dict.items():
+        clean_key = k.replace('module.', '')
+        clean_state_dict[clean_key] = v
+
+    model.load_state_dict(clean_state_dict, strict=False)
+    return model
+
+def generate_random_inputs(args):
+    input_dict = {
+        'ego_current_state':      torch.randn(1, args.predicted_neighbor_num, device=args.device),
+        'neighbor_agents_past':   torch.randn(1, args.agent_num, args.time_len, args.agent_state_dim, device=args.device),
+        'static_objects':         torch.randn(1, args.static_objects_num, args.static_objects_state_dim, device=args.device),
+        'lanes':                  torch.randn(1, args.lane_num, args.lane_len, args.lane_state_dim, device=args.device),
+        'lanes_speed_limit':      torch.randn(1, args.lane_num, 1, device=args.device),
+        'lanes_has_speed_limit':  torch.randint(0, 2, (1, args.lane_num, 1), dtype=torch.bool, device=args.device),
+        'route_lanes':            torch.randn(1, args.route_num, args.route_len, args.route_state_dim, device=args.device),
+    }
+    input_list = [input_dict[k] for k in input_dict]
+    return input_dict, input_list
+
+def main():
+    args = get_args()
+
+    model = Diffusion_Planner_TRT(args).to(args.device)
+    model = load_ckpt_weights(model, args.model_ckpt, device=args.device)
+    model.eval()
+
+    input_dict, inputs = generate_random_inputs(args)
+
+    # Disable advanced attention kernels to ensure ONNX-exportable operations.
+    # This ensures all attention ops fall back to math-based (non-fused) implementations,
+    # which are compatible with ONNX tracing and export.
+    torch.backends.cuda.enable_flash_sdp(False)
+    torch.backends.cuda.enable_mem_efficient_sdp(False)
+    torch.backends.cuda.enable_math_sdp(True)
+    torch.backends.mha.set_fastpath_enabled(False)
+
+    torch.onnx.export(
+        model,
+        inputs,
+        args.onnx_output,
+        input_names=list(input_dict.keys()),
+        output_names=["encoder_outputs", "decoder_outputs"],
+        opset_version=20
+    )
+    # ONNX simplification 
+    print("   ONNX Simplifying...")
+    model = onnx.load(args.onnx_output)
+    model_simp, check = simplify(model)
+    assert check, "Simplified ONNX model could not be validated"
+
+    onnx.save(model_simp, args.onnx_output)
+    print(f"Simplified ONNX model is save at: {args.onnx_output}")
+
+if __name__ == "__main__":
+    main()

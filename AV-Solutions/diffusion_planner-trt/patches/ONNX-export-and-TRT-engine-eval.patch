+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+ 
+#include <iostream>
+#include <vector>
+#include <string>
+#include <cstring>
+#include <fstream>
+#include <algorithm>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include <unistd.h>
+#include <cerrno>
+#include <numeric>
+#include <chrono>
+
+// Configuration constants
+namespace {
+    constexpr int DEFAULT_PORT = 5555;
+    constexpr const char* DEFAULT_HOST = "127.0.0.1";
+    constexpr size_t MAX_BUFFER_SIZE = 1500 * 1024 * 1024; // 1.5GB - Safety limit for tensor data transfers
+}
+
+// Socket helper functions (compatible with both server implementations)
+class SocketClient {
+private:
+    int sock_fd;
+    bool connected;
+
+public:
+    SocketClient() : sock_fd(-1), connected(false) {}
+    
+    ~SocketClient() {
+        disconnect();
+    }
+
+    bool connect(const std::string& host, int port) {
+        sock_fd = socket(AF_INET, SOCK_STREAM, 0);
+        if (sock_fd < 0) {
+            std::cerr << "[Client] Failed to create socket: " << strerror(errno) << std::endl;
+            return false;
+        }
+
+        // Set socket timeouts
+        struct timeval timeout;
+        timeout.tv_sec = 120;  // 120 second timeout to match server
+        timeout.tv_usec = 0;
+        setsockopt(sock_fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+        setsockopt(sock_fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+
+        // Set socket buffer sizes for large transfers
+        int bufsize = 16 * 1024 * 1024;  // 16MB buffer
+        setsockopt(sock_fd, SOL_SOCKET, SO_RCVBUF, &bufsize, sizeof(bufsize));
+        setsockopt(sock_fd, SOL_SOCKET, SO_SNDBUF, &bufsize, sizeof(bufsize));
+
+        struct sockaddr_in server_addr;
+        memset(&server_addr, 0, sizeof(server_addr));
+        server_addr.sin_family = AF_INET;
+        server_addr.sin_port = htons(port);
+        
+        if (inet_pton(AF_INET, host.c_str(), &server_addr.sin_addr) <= 0) {
+            std::cerr << "[Client] Invalid address: " << host << std::endl;
+            close(sock_fd);
+            return false;
+        }
+
+        if (::connect(sock_fd, (struct sockaddr*)&server_addr, sizeof(server_addr)) < 0) {
+            std::cerr << "[Client] Connection failed: " << strerror(errno) << std::endl;
+            close(sock_fd);
+            return false;
+        }
+
+        connected = true;
+        std::cout << "[Client] Connected to " << host << ":" << port << std::endl;
+        return true;
+    }
+
+    void disconnect() {
+        if (connected && sock_fd >= 0) {
+            close(sock_fd);
+            connected = false;
+            std::cout << "[Client] Disconnected" << std::endl;
+        }
+    }
+
+    // Send data with proper error handling
+    bool sendAll(const void* data, size_t size) {
+        if (!connected) return false;
+        
+        const char* ptr = static_cast<const char*>(data);
+        size_t sent = 0;
+        
+        while (sent < size) {
+            ssize_t result = send(sock_fd, ptr + sent, size - sent, 0);
+            if (result <= 0) {
+                if (result < 0) {
+                    std::cerr << "[Client] Send error: " << strerror(errno) << std::endl;
+                } else {
+                    std::cerr << "[Client] Connection closed by server" << std::endl;
+                }
+                return false;
+            }
+            sent += result;
+        }
+        return true;
+    }
+
+    // Receive data with proper error handling
+    bool recvAll(void* data, size_t size) {
+        if (!connected) return false;
+        
+        char* ptr = static_cast<char*>(data);
+        size_t received = 0;
+        
+        while (received < size) {
+            ssize_t result = recv(sock_fd, ptr + received, size - received, 0);
+            if (result <= 0) {
+                if (result < 0) {
+                    std::cerr << "[Client] Receive error: " << strerror(errno) << std::endl;
+                } else {
+                    std::cerr << "[Client] Connection closed by server" << std::endl;
+                }
+                return false;
+            }
+            received += result;
+        }
+        return true;
+    }
+
+    // Send 32-bit integer in little-endian format (compatible with both servers)
+    bool sendInt32LE(int32_t value) {
+        uint8_t bytes[4];
+        bytes[0] = value & 0xFF;
+        bytes[1] = (value >> 8) & 0xFF;
+        bytes[2] = (value >> 16) & 0xFF;
+        bytes[3] = (value >> 24) & 0xFF;
+        return sendAll(bytes, 4);
+    }
+
+    // Receive 32-bit integer in little-endian format
+    bool recvInt32LE(int32_t& value) {
+        uint8_t bytes[4];
+        if (!recvAll(bytes, 4)) return false;
+        value = bytes[0] | (bytes[1] << 8) | (bytes[2] << 16) | (bytes[3] << 24);
+        return true;
+    }
+};
+
+// Tensor data structure
+struct Tensor {
+    std::vector<int> shape;
+    std::vector<float> data;
+    
+    size_t volume() const {
+        if (shape.empty()) return 0;
+        return std::accumulate(shape.begin(), shape.end(), 1, std::multiplies<int>());
+    }
+    
+    void print_stats(const std::string& name) const {
+        if (data.empty()) {
+            std::cout << "[" << name << "] Empty tensor" << std::endl;
+            return;
+        }
+        
+        float sum = std::accumulate(data.begin(), data.end(), 0.0f);
+        float mean = sum / data.size();
+        auto minmax = std::minmax_element(data.begin(), data.end());
+        
+        std::cout << "[" << name << "] Shape: [";
+        for (size_t i = 0; i < shape.size(); ++i) {
+            std::cout << shape[i] << (i + 1 == shape.size() ? "" : ", ");
+        }
+        std::cout << "] Volume: " << volume() 
+                  << " Mean: " << mean 
+                  << " Min: " << *minmax.first 
+                  << " Max: " << *minmax.second << std::endl;
+    }
+};
+
+// Load tensor data from file (simple binary format: shape_dims, shape_values..., float_data...)
+bool loadTensorFromFile(const std::string& filename, Tensor& tensor) {
+    std::ifstream file(filename, std::ios::binary);
+    if (!file) {
+        std::cerr << "[Client] Failed to open tensor file: " << filename << std::endl;
+        return false;
+    }
+
+    // Read shape
+    int32_t ndims;
+    file.read(reinterpret_cast<char*>(&ndims), sizeof(ndims));
+    if (ndims <= 0 || ndims > 8) {
+        std::cerr << "[Client] Invalid tensor dimensions: " << ndims << std::endl;
+        return false;
+    }
+
+    tensor.shape.resize(ndims);
+    file.read(reinterpret_cast<char*>(tensor.shape.data()), ndims * sizeof(int32_t));
+
+    // Read data
+    size_t vol = tensor.volume();
+    tensor.data.resize(vol);
+    file.read(reinterpret_cast<char*>(tensor.data.data()), vol * sizeof(float));
+
+    if (!file) {
+        std::cerr << "[Client] Failed to read tensor data from file" << std::endl;
+        return false;
+    }
+
+    return true;
+}
+
+// Save tensor data to file
+bool saveTensorToFile(const std::string& filename, const Tensor& tensor) {
+    std::ofstream file(filename, std::ios::binary);
+    if (!file) {
+        std::cerr << "[Client] Failed to create output file: " << filename << std::endl;
+        return false;
+    }
+
+    // Write shape
+    int32_t ndims = static_cast<int32_t>(tensor.shape.size());
+    file.write(reinterpret_cast<const char*>(&ndims), sizeof(ndims));
+    file.write(reinterpret_cast<const char*>(tensor.shape.data()), ndims * sizeof(int32_t));
+
+    // Write data
+    file.write(reinterpret_cast<const char*>(tensor.data.data()), tensor.data.size() * sizeof(float));
+
+    return file.good();
+}
+
+// Create a simple test tensor
+Tensor createTestTensor(const std::vector<int>& shape, float base_value = 1.0f) {
+    Tensor tensor;
+    tensor.shape = shape;
+    size_t vol = tensor.volume();
+    tensor.data.resize(vol);
+    
+    // Fill with simple pattern
+    for (size_t i = 0; i < vol; ++i) {
+        tensor.data[i] = base_value + static_cast<float>(i) * 0.001f;
+    }
+    
+    return tensor;
+}
+
+// Perform inference using the compatible protocol
+bool performInference(SocketClient& client, const std::vector<Tensor>& inputs, Tensor& output) {
+    auto start_time = std::chrono::high_resolution_clock::now();
+    
+    // Send number of input tensors
+    if (!client.sendInt32LE(static_cast<int32_t>(inputs.size()))) {
+        std::cerr << "[Client] Failed to send tensor count" << std::endl;
+        return false;
+    }
+
+    // Send tensor shapes
+    for (const auto& tensor : inputs) {
+        // Send rank
+        if (!client.sendInt32LE(static_cast<int32_t>(tensor.shape.size()))) {
+            std::cerr << "[Client] Failed to send tensor rank" << std::endl;
+            return false;
+        }
+        
+        // Send dimensions
+        for (int dim : tensor.shape) {
+            if (!client.sendInt32LE(dim)) {
+                std::cerr << "[Client] Failed to send tensor dimension" << std::endl;
+                return false;
+            }
+        }
+    }
+
+    // Send tensor data
+    for (const auto& tensor : inputs) {
+        size_t data_size = tensor.data.size() * sizeof(float);
+        if (!client.sendAll(tensor.data.data(), data_size)) {
+            std::cerr << "[Client] Failed to send tensor data" << std::endl;
+            return false;
+        }
+        std::cout << "[Client] Sent tensor data: " << data_size << " bytes" << std::endl;
+    }
+
+    // Receive response size
+    int32_t response_size;
+    if (!client.recvInt32LE(response_size)) {
+        std::cerr << "[Client] Failed to receive response size" << std::endl;
+        return false;
+    }
+
+    if (response_size <= 0) {
+        std::cerr << "[Client] Server returned error (response_size=" << response_size << ")" << std::endl;
+        return false;
+    }
+
+    std::cout << "[Client] Receiving response: " << response_size << " bytes" << std::endl;
+
+    // Receive output data
+    size_t num_floats = response_size / sizeof(float);
+    output.data.resize(num_floats);
+    if (!client.recvAll(output.data.data(), response_size)) {
+        std::cerr << "[Client] Failed to receive output data" << std::endl;
+        return false;
+    }
+
+    // Set output shape (assume 1D for simplicity, can be enhanced)
+    output.shape = {static_cast<int>(num_floats)};
+
+    auto end_time = std::chrono::high_resolution_clock::now();
+    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(end_time - start_time);
+    std::cout << "[Client] Inference completed in " << duration.count() << " ms" << std::endl;
+
+    return true;
+}
+
+void printUsage(const char* program_name) {
+    std::cout << "Usage: " << program_name << " [options]\n"
+              << "Options:\n"
+              << "  --host <host>        Server host (default: " << DEFAULT_HOST << ")\n"
+              << "  --port <port>        Server port (default: " << DEFAULT_PORT << ")\n"
+              << "  --input <file>       Input tensor file (binary format)\n"
+              << "  --output <file>      Output tensor file (binary format)\n"
+              << "  --test               Run with generated test data\n"
+              << "  --help               Show this help message\n"
+              << "\nExamples:\n"
+              << "  " << program_name << " --test\n"
+              << "  " << program_name << " --host 192.168.1.100 --input tensor.bin --output result.bin\n";
+}
+
+int main(int argc, char* argv[]) {
+    std::string host = DEFAULT_HOST;
+    int port = DEFAULT_PORT;
+    std::string input_file;
+    std::string output_file;
+    bool use_test_data = false;
+
+    // Parse command line arguments
+    for (int i = 1; i < argc; ++i) {
+        std::string arg = argv[i];
+        if (arg == "--help") {
+            printUsage(argv[0]);
+            return 0;
+        } else if (arg == "--host" && i + 1 < argc) {
+            host = argv[++i];
+        } else if (arg == "--port" && i + 1 < argc) {
+            port = std::atoi(argv[++i]);
+        } else if (arg == "--input" && i + 1 < argc) {
+            input_file = argv[++i];
+        } else if (arg == "--output" && i + 1 < argc) {
+            output_file = argv[++i];
+        } else if (arg == "--test") {
+            use_test_data = true;
+        } else {
+            std::cerr << "Unknown argument: " << arg << std::endl;
+            printUsage(argv[0]);
+            return 1;
+        }
+    }
+
+    try {
+        SocketClient client;
+        
+        // Connect to server
+        if (!client.connect(host, port)) {
+            return 1;
+        }
+
+        // Prepare input tensors
+        std::vector<Tensor> inputs;
+        
+        if (use_test_data) {
+            std::cout << "[Client] Using generated test data" << std::endl;
+            // Create some test tensors with different shapes
+            inputs.push_back(createTestTensor({1, 3, 224, 224}, 0.5f));  // Typical image input
+            inputs.push_back(createTestTensor({1, 1000}, 1.0f));         // Typical classifier input
+        } else if (!input_file.empty()) {
+            std::cout << "[Client] Loading tensor from file: " << input_file << std::endl;
+            Tensor input_tensor;
+            if (!loadTensorFromFile(input_file, input_tensor)) {
+                return 1;
+            }
+            inputs.push_backs(input_tensor);
+        } else {
+            std::cerr << "[Client] No input specified. Use --test or --input <file>" << std::endl;
+            return 1;
+        }
+
+        // Print input statistics
+        for (size_t i = 0; i < inputs.size(); ++i) {
+            inputs[i].print_stats("Input_" + std::to_string(i));
+        }
+
+        // Perform inference
+        Tensor output;
+        if (!performInference(client, inputs, output)) {
+            std::cerr << "[Client] Inference failed" << std::endl;
+            return 1;
+        }
+
+        // Print output statistics
+        output.print_stats("Output");
+
+        // Save output if requested
+        if (!output_file.empty()) {
+            if (saveTensorToFile(output_file, output)) {
+                std::cout << "[Client] Output saved to: " << output_file << std::endl;
+            } else {
+                std::cerr << "[Client] Failed to save output to file" << std::endl;
+            }
+        }
+
+        std::cout << "[Client] Inference completed successfully" << std::endl;
+
+    } catch (const std::exception& e) {
+        std::cerr << "[Client] Error: " << e.what() << std::endl;
+        return 1;
+    }
+
+    return 0;
+} 
